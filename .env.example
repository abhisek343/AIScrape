# Copy to .env for local Compose. Values below are non-secret placeholders.
# Clerk and Stripe features require their own test-mode credentials. The
# publishable placeholder below only makes the public landing page buildable;
# replace it with a real test key to enable authentication. Core queue and
# database containers do not require it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_API_KEY=
GEMINI_ENABLE_GOOGLE_SEARCH=false
# Optional: comma-separated public hostnames. Empty permits public HTTP(S)
# targets but still rejects loopback, private networks, and metadata endpoints.
SCRAPE_ALLOWED_HOSTS=example.com
# strict fails closed if robots.txt cannot be read; set advisory only for a
# controlled local fixture. `off` is reserved for tests and is not recommended.
SCRAPE_ROBOTS_MODE=strict
SCRAPE_MIN_INTERVAL_MS=1000
# Use BROWSER_MODE=remote only when BRIGHT_DATA_BROWSER_WS is injected by a
# managed secret store. The Compose demo sets BROWSER_MODE=local itself.
BROWSER_MODE=local
BRIGHT_DATA_BROWSER_WS=
